{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "download/**",
      ".verify/**",
      "worklog.md",
      "dev-server.log",
      "gallery/**",
      "videos/**",
      "docs/**",
      "tests/**",
      "worker/**",
      "image*.png",
      "preview-*.png",
      "*.log"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=300"
          }
        ]
      }
    ]
  }
}
