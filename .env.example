# Attune — environment template. Copy to .env.local and fill in.
# .env.local is gitignored; keys never ship to the browser.

# Required — Qloo Taste AI API key (hackathon developer key)
QLOO_API_KEY=hack_...

# Optional — enables the live LLM path of the playbook agent.
# If unset, the agent uses the z-ai CLI when available, then falls back to the
# built-in deterministic composer (the route always answers 200).
# LLM_API_KEY=sk-...
# LLM_PROVIDER=openai        # openai | gemini | anthropic
# LLM_MODEL=gpt-4o-mini      # provider default used when omitted

# Local server
# PORT=3000
