# Attune — Caddyfile (single-origin production shape)
# ---------------------------------------------------------------------
# Serves the static app and proxies the Qloo API on one port, mirroring
# the firebase hosting + functions layout:
#
#   /                     static app (index.html, auth.html, assets)
#   /api/qloo/v2/...   -> https://hackathon.api.qloo.com  (prefix stripped,
#                          X-Api-Key injected from $QLOO_API_KEY — the key
#                          never touches the browser or this file)
#   /api/llm/playbook  -> scripts/llm-sidecar.js on 127.0.0.1:3789
#                          (playbook agent: Qloo enrichment + LLM compose,
#                           deterministic fallback — always answers 200)
#
# Run:  scripts/serve.sh     (sources .env.local for QLOO_API_KEY)

{
        admin off
        auto_https off
}

:3000 {
        encode zstd gzip

        # --- LLM playbook agent -------------------------------------------
        # Playbook agent sidecar (spawned idempotently by scripts/serve.sh).
        # Qloo enrichment + LLM composition + deterministic fallback, so the
        # route always answers 200 with a grounded playbook.
        handle /api/llm/playbook {
                reverse_proxy 127.0.0.1:3789
        }

        # --- Qloo Taste AI proxy ------------------------------------------
        handle_path /api/qloo/* {
                header Cache-Control "public, max-age=300"
                reverse_proxy https://hackathon.api.qloo.com {
                        header_up Host hackathon.api.qloo.com
                        header_up X-Api-Key {env.QLOO_API_KEY}
                        transport http {
                                tls
                                tls_server_name hackathon.api.qloo.com
                        }
                }
        }

        # --- Static app ----------------------------------------------------
        handle {
                root * .
                try_files {path} {path}/ /index.html
                header /audio/* Cache-Control "public, max-age=86400"
                header /logo/*  Cache-Control "public, max-age=86400"
                file_server
        }
}
